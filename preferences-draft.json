{
  "schema_version": 1,
  "status": "draft_not_applied_to_running_bot",
  "store": "amazon.fr",
  "currency": "EUR",
  "categories": [
    "PC components",
    "gaming peripherals",
    "consoles and accessories",
    "video games",
    "VR and gaming gadgets",
    "smartphones and Apple devices",
    "TV and audio",
    "home appliances",
    "exceptional deals any category"
  ],
  "price_after_discount_eur": {
    "min": 0,
    "max": null
  },
  "min_real_savings_eur": 0,
  "min_discount_percent": 50,
  "priority_discount_percent": 70,
  "out_of_budget_exception": {
    "enabled": true,
    "min_discount_percent": 70,
    "min_absolute_saving_eur": 100
  },
  "preferred_brand_groups": [
    "Apple",
    "Sony / PlayStation",
    "Samsung",
    "LG",
    "ASUS / MSI",
    "Logitech / Razer / Corsair",
    "Nintendo",
    "Meta / Valve",
    "Crucial / WD / Kingston",
    "JBL / Bose / Sony Audio",
    "Dyson / Roborock",
    "Philips / De'Longhi"
  ],
  "preferred_brand_policy": "priority_not_hard_exclusion",
  "exclusions": [
    "used_or_refurbished",
    "unreputable_unknown_brands",
    "suspicious_third_party_sellers"
  ],
  "deal_confidence": [
    "independently_verified",
    "potential_deal_labeled_unverified"
  ],
  "note": "User-selected draft preferences only, now including Amazon France Spain Italy and delivery-to-France comparison rules. Not consumed by current bot.py/workflow. Running bot code unchanged. Evening report time still pending confirmation.",
  "notifications": {
    "channel": "telegram",
    "deal_delivery": {
      "mode": "send_each_qualifying_deal_as_discovered",
      "min_discount_percent": 50,
      "send_time": "next_successful_scan",
      "note": "Not a real-time push; expected polling approximately every 15 minutes with possible GitHub Actions delays."
    },
    "unverified_candidates": {
      "enabled": true,
      "min_claimed_discount_percent": 50,
      "must_be_clearly_labeled_unverified": true
    },
    "quiet_hours": {
      "enabled": false,
      "timezone": "Europe/Paris",
      "delivery": "24/7"
    },
    "deduplication": {
      "enabled": true,
      "do_not_repeat_unchanged_offers": true,
      "notify_again_only_if_offer_materially_improves": true
    },
    "daily_report": {
      "enabled": true,
      "format": "evening_summary",
      "timezone": "Europe/Paris",
      "local_time": null,
      "local_time_status": "needs_confirmation_before_implementation",
      "include_zero_findings": true,
      "include": "number_of_posts_scanned, new_candidates, confirmed_deals_if_any, notable_offers and source/verification caveats"
    }
  },
  "markets": [
    "amazon.fr",
    "amazon.es",
    "amazon.it"
  ],
  "destination_country": "FR",
  "cross_border_rules": {
    "allow_amazon_es_and_amazon_it": true,
    "france_delivery_required": true,
    "compare_effective_delivered_price_eur": true,
    "effective_price_components": [
      "item price incl applicable VAT",
      "shipping to France",
      "mandatory additional fees",
      "coupon or Prime conditions if eligible"
    ],
    "marketplace_specific_offer_and_stock_check": true,
    "compare_with_france_alternative_if_possible": true,
    "link_must_target_exact_product_page_on_source_marketplace": true,
    "direct_link_examples": [
      "https://www.amazon.fr/dp/ASIN",
      "https://www.amazon.es/dp/ASIN",
      "https://www.amazon.it/dp/ASIN"
    ],
    "flag_unconfirmed_shipping_availability": true,
    "exclude_non_deliverable_to_france": true,
    "warn_about_variant_language_plugs_keyboard_and_warranty_if_relevant": true,
    "avoid_claiming_same_ASIN_or_offer_exists_in_all_marketplaces": true
  }
}
