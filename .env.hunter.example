# Copy to .env.hunter, keep private and never commit secrets.
# All Creators credentials need valid Amazon Associates approval.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG_FR=
AMAZON_PARTNER_TAG_DE=
AMAZON_PARTNER_TAG_ES=
AMAZON_PARTNER_TAG_IT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional comma-separated URLs for known products to recheck.
DIRECT_WATCH_ASINS=
# Typical interval 60-120 seconds, subject to your Amazon API quota.
DIRECT_INTERVAL_SECONDS=90
DIRECT_MAX_QUERIES=2
DIRECT_WATCH_BATCHES=1
